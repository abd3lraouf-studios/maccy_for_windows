#pragma code_page(65001)

#include <winresrc.h>
#include "resource.h"

// Captions below mirror the English IDS_* strings in Localization.rc, which
// replace them at runtime; they only keep the templates readable.

IDD_SETTINGS DIALOGEX 0, 0, 320, 235
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_APPWINDOW | WS_EX_CONTROLPARENT
CAPTION "Preferences"
FONT 9, "Segoe UI"
BEGIN
    // The pages are created as siblings above this tab control, so it must
    // not paint over them.
    CONTROL "", IDC_SETTINGS_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_CLIPSIBLINGS | TCS_TABS, 0, 0, 320, 235
END

IDD_PAGE_GENERAL DIALOGEX 2, 13, 316, 216
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Launch at login", IDC_G_LAUNCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 5, 300, 10
    CONTROL "Check for updates automatically", IDC_G_UPDATES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 17, 300, 10
    PUSHBUTTON "Check now", IDC_G_CHECK_NOW, 40, 29, 70, 10

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 45, 300, 1
    RTEXT "Open:", IDC_G_OPEN_LABEL, 0, 49, 40, 10, SS_CENTERIMAGE
    EDITTEXT IDC_G_OPEN_HOTKEY, 40, 49, 70, 10, ES_AUTOHSCROLL | ES_CENTER | ES_READONLY | WS_TABSTOP
    RTEXT "Pin:", IDC_G_PIN_LABEL, 0, 65, 40, 10, SS_CENTERIMAGE
    EDITTEXT IDC_G_PIN_HOTKEY, 40, 65, 70, 10, ES_AUTOHSCROLL | ES_CENTER | ES_READONLY | WS_TABSTOP
    RTEXT "Delete:", IDC_G_DELETE_LABEL, 0, 81, 40, 10, SS_CENTERIMAGE
    EDITTEXT IDC_G_DELETE_HOTKEY, 40, 81, 70, 10, ES_AUTOHSCROLL | ES_CENTER | ES_READONLY | WS_TABSTOP
    RTEXT "Preview:", IDC_G_PREVIEW_LABEL, 0, 97, 40, 10, SS_CENTERIMAGE
    EDITTEXT IDC_G_PREVIEW_HOTKEY, 40, 97, 70, 10, ES_AUTOHSCROLL | ES_CENTER | ES_READONLY | WS_TABSTOP

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 112, 300, 1
    RTEXT "Search:", IDC_G_SEARCH_LABEL, 0, 115, 40, 10, SS_CENTERIMAGE
    COMBOBOX IDC_G_SEARCH_MODE, 40, 115, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 131, 300, 1
    RTEXT "Behavior:", IDC_G_BEHAVIOR_LABEL, 0, 136, 40, 10, SS_CENTERIMAGE
    CONTROL "Paste automatically", IDC_G_PASTE_BY_DEFAULT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 136, 300, 10
    CONTROL "Paste as plain text", IDC_G_REMOVE_FORMATTING, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 148, 300, 10
    LTEXT "Customize what happens when selecting an item:\r\n• Hold Enter to select an item to copy.\r\n• Hold Alt+Enter to select an item to copy and paste.\r\n• Hold Alt+Shift+Enter to select an item to copy and paste with matching formatting.", IDC_G_BEHAVIOR_HINT, 40, 160, 268, 36, SS_NOPREFIX

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 198, 300, 1
    PUSHBUTTON "Notifications and sounds", IDC_G_NOTIFICATIONS, 40, 201, 70, 10
END

IDD_PAGE_APPEARANCE DIALOGEX 2, 13, 316, 220
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    // CBS_DROPDOWNLIST clamps its closed field to the font row; match that height.
    RTEXT "Popup position:", IDC_A_POPUP_POSITION_LABEL, 0, 5, 52, 10, SS_CENTERIMAGE
    // Keep 14 DLU for the expanded list; the closed field is automatically 10 DLU.
    COMBOBOX IDC_A_POPUP_POSITION, 52, 5, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT "Screen:", IDC_A_SCREEN_LABEL, 112, 5, 40, 10, SS_CENTERIMAGE
    COMBOBOX IDC_A_POPUP_SCREEN, 152, 5, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Reset position", IDC_A_RESET_POSITION, 212, 5, 40, 10
    RTEXT "Pin to:", IDC_A_PIN_TO_LABEL, 0, 21, 52, 10, SS_CENTERIMAGE
    COMBOBOX IDC_A_PIN_TO, 52, 21, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    // Wider than the other combos so "Tokyo Night" and "Match Windows" fit.
    RTEXT "Theme:", IDC_A_THEME_LABEL, 112, 21, 40, 10, SS_CENTERIMAGE
    COMBOBOX IDC_A_THEME, 152, 21, 70, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT "Image height:", IDC_A_IMAGE_HEIGHT_LABEL, 0, 38, 52, 10, SS_CENTERIMAGE
    EDITTEXT IDC_A_IMAGE_HEIGHT, 52, 38, 54, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    RTEXT "Mode:", IDC_A_THEME_MODE_LABEL, 112, 38, 40, 10, SS_CENTERIMAGE
    COMBOBOX IDC_A_THEME_MODE, 152, 38, 70, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Open preview automatically", IDC_A_OPEN_PREVIEW, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 52, 55, 252, 10
    RTEXT "Preview delay:", IDC_A_PREVIEW_DELAY_LABEL, 0, 68, 52, 10, SS_CENTERIMAGE
    EDITTEXT IDC_A_PREVIEW_DELAY, 52, 68, 54, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    RTEXT "Highlight matches:", IDC_A_HIGHLIGHT_LABEL, 0, 83, 52, 10, SS_CENTERIMAGE
    COMBOBOX IDC_A_HIGHLIGHT, 52, 83, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 52, 99, 256, 1
    CONTROL "Show special symbols", IDC_A_SHOW_SPECIAL, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 52, 102, 252, 10
    CONTROL "Show system tray icon", IDC_A_SHOW_STATUS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 52, 114, 252, 10
    COMBOBOX IDC_A_MENU_ICON, 52, 124, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Show recent clipboard content next to the system tray icon", IDC_A_SHOW_RECENT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_DISABLED, 52, 138, 252, 10
    CONTROL "Show search box", IDC_A_SHOW_SEARCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 52, 150, 252, 10
    COMBOBOX IDC_A_SEARCH_VISIBILITY, 52, 160, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Show the application name before the search box", IDC_A_SHOW_TITLE, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 52, 174, 252, 10
    CONTROL "Show application icons", IDC_A_SHOW_ICONS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 52, 186, 252, 10
    CONTROL "Show hexadecimal color swatches", IDC_A_SHOW_SWATCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 52, 198, 252, 10
    CONTROL "Show footer menu", IDC_A_SHOW_FOOTER, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 52, 210, 252, 10
END

IDD_PAGE_STORAGE DIALOGEX 2, 13, 316, 216
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    RTEXT "Save:", IDC_S_SAVE_LABEL, 0, 7, 40, 10, SS_CENTERIMAGE
    CONTROL "Files", IDC_S_SAVE_FILES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 7, 300, 10
    CONTROL "Images", IDC_S_SAVE_IMAGES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 19, 300, 10
    CONTROL "Text", IDC_S_SAVE_TEXT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 31, 300, 10
    LTEXT "Choose which types of content are saved.", IDC_S_DESCRIPTION, 40, 43, 140, 10, SS_CENTERIMAGE | SS_NOPREFIX
    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 59, 300, 1
    RTEXT "Count:", IDC_S_COUNT_LABEL, 0, 63, 40, 10, SS_CENTERIMAGE
    EDITTEXT IDC_S_HISTORY_SIZE, 40, 63, 54, 10, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_S_STORAGE_SIZE, 100, 63, 208, 10, SS_CENTERIMAGE | SS_NOPREFIX
    RTEXT "Sort by:", IDC_S_SORT_LABEL, 0, 78, 40, 10, SS_CENTERIMAGE
    COMBOBOX IDC_S_SORT_BY, 40, 78, 62, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_PAGE_IGNORE DIALOGEX 2, 13, 316, 216
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    // The ignore sub-pages are created as siblings above this tab control.
    CONTROL "", IDC_IGNORE_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_CLIPSIBLINGS | TCS_TABS, 8, 5, 300, 204
END

IDD_IGNORE_APPLICATIONS DIALOGEX 2, 13, 296, 189
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_I_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | LVS_EDITLABELS | WS_TABSTOP | WS_BORDER, 8, 8, 300, 119, WS_EX_CLIENTEDGE
    PUSHBUTTON "Add", IDC_I_ADD, 8, 131, 28, 10
    PUSHBUTTON "Remove", IDC_I_REMOVE, 40, 131, 28, 10
    CONTROL "Ignore all applications except those in the list", IDC_I_WHITELIST, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 78, 131, 300, 10
    LTEXT "", IDC_I_DESCRIPTION, 8, 145, 280, 36, SS_NOPREFIX
END

IDD_IGNORE_FORMATS DIALOGEX 2, 13, 296, 189
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_I_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_TABSTOP | WS_BORDER, 8, 8, 280, 119, WS_EX_CLIENTEDGE
    PUSHBUTTON "Add", IDC_I_ADD, 8, 131, 28, 10
    PUSHBUTTON "Remove", IDC_I_REMOVE, 40, 131, 28, 10
    PUSHBUTTON "Reset", IDC_I_RESET, 238, 131, 50, 10
    LTEXT "", IDC_I_DESCRIPTION, 8, 145, 280, 36, SS_NOPREFIX
END

IDD_IGNORE_REGEXPS DIALOGEX 2, 13, 296, 189
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_I_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_TABSTOP | WS_BORDER, 8, 8, 280, 119, WS_EX_CLIENTEDGE
    PUSHBUTTON "Add", IDC_I_ADD, 8, 131, 28, 10
    PUSHBUTTON "Remove", IDC_I_REMOVE, 40, 131, 28, 10
    LTEXT "", IDC_I_DESCRIPTION, 8, 145, 280, 36, SS_NOPREFIX
END

IDD_PAGE_PINS DIALOGEX 2, 13, 316, 216
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_P_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_TABSTOP | WS_BORDER, 8, 5, 300, 187, WS_EX_CLIENTEDGE
    LTEXT "You can customize the hotkey, title, and content of any pinned item.\r\nTo edit an item, double-click it and enter a new value.", IDC_P_LIST_HINT, 8, 194, 300, 28, SS_NOPREFIX
END

IDD_PAGE_ADVANCED DIALOGEX 2, 13, 316, 216
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Pause", IDC_X_IGNORE_EVENTS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 5, 300, 10
    LTEXT "Pause recording new clipboard items.\r\nUse this when you want to disable recording programmatically while copying sensitive data.", IDC_X_DESCRIPTION, 8, 17, 300, 16, SS_LEFT | SS_NOPREFIX
    CONTROL "Ignore only the next clipboard change", IDC_X_IGNORE_NEXT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 35, 300, 10
    LTEXT "", IDC_STATIC, 8, 48, 300, 1, SS_ETCHEDHORZ
    CONTROL "Clear history on exit", IDC_X_CLEAR_ON_QUIT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 51, 300, 10
    CONTROL "Clear the system clipboard too", IDC_X_CLEAR_CLIPBOARD, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 63, 300, 10
    CONTROL "Respect Windows clipboard history markers", IDC_X_RESPECT_WINDOWS_CLIPBOARD_HISTORY, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 76, 300, 10
    LTEXT "Do not record content marked by Windows as excluded from clipboard history.", IDC_X_HISTORY_DESCRIPTION, 8, 88, 300, 10, SS_LEFT | SS_NOPREFIX
END

IDD_EDIT_PIN DIALOGEX 0, 0, 280, 200
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit pinned item"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Hotkey (&K):", IDC_EDIT_PIN_KEY_LABEL, 10, 10, 44, 10, SS_CENTERIMAGE
    COMBOBOX IDC_EDIT_PIN_KEY, 58, 10, 60, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Alias (&T):", IDC_EDIT_PIN_TITLE_LABEL, 10, 30, 40, 10, SS_CENTERIMAGE
    EDITTEXT IDC_EDIT_PIN_TITLE, 10, 42, 260, 10, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "Content (&C):", IDC_EDIT_PIN_CONTENT_LABEL, 10, 62, 40, 10, SS_CENTERIMAGE
    EDITTEXT IDC_EDIT_PIN_CONTENT, 10, 74, 260, 76, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_P_CONTENT_HINT, 10, 154, 260, 20, SS_CENTERIMAGE | SS_NOPREFIX
    DEFPUSHBUTTON "OK", IDOK, 164, 178, 50, 10
    PUSHBUTTON "Cancel", IDCANCEL, 220, 178, 50, 10
END

IDD_EDIT_IGNORE DIALOGEX 0, 0, 280, 120
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit ignore item"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Value (&V):", IDC_EDIT_IGNORE_VALUE_LABEL, 10, 10, 40, 10, SS_CENTERIMAGE
    EDITTEXT IDC_EDIT_IGNORE_VALUE, 10, 22, 260, 10, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_I_DESCRIPTION, 10, 42, 260, 46, SS_NOPREFIX
    DEFPUSHBUTTON "OK", IDOK, 164, 98, 50, 10
    PUSHBUTTON "Cancel", IDCANCEL, 220, 98, 50, 10
END
