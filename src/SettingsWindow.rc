#pragma code_page(65001)

#include <winresrc.h>
#include "resource.h"

// Captions below mirror the English IDS_* strings in Localization.rc, which
// replace them at runtime; they only keep the templates readable.
// Separator lines are SS_OWNERDRAW statics, which ThemedDialog draws in the
// palette's border colour; an etched static cannot be recoloured.
//
// One grid for every page (dialog units): 10 DLU margins; right-aligned
// labels from x 10 to 66 and controls from x 70, so a label never touches
// its control; text fields and buttons 14 DLU tall (combo boxes size their
// closed field to the font); rows of fields every 17-18 DLU, check boxes
// every 13 DLU; 8 DLU between a separator and the rows around it.

IDD_SETTINGS DIALOGEX 0, 0, 340, 320
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_APPWINDOW | WS_EX_CONTROLPARENT
CAPTION "Preferences"
FONT 9, "Segoe UI"
BEGIN
    // The pages are created as siblings above this tab control, so it must
    // not paint over them.
    CONTROL "", IDC_SETTINGS_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_CLIPSIBLINGS | TCS_TABS, 0, 0, 340, 320
END

IDD_PAGE_GENERAL DIALOGEX 2, 13, 336, 304
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Launch at login", IDC_G_LAUNCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 10, 256, 10
    CONTROL "Check for updates automatically", IDC_G_UPDATES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 23, 256, 10
    PUSHBUTTON "Check now", IDC_G_CHECK_NOW, 70, 37, 64, 14

    CONTROL "", IDC_STATIC, "Static", SS_OWNERDRAW, 10, 59, 316, 1
    RTEXT "Open:", IDC_G_OPEN_LABEL, 10, 67, 56, 14, SS_CENTERIMAGE
    EDITTEXT IDC_G_OPEN_HOTKEY, 70, 67, 84, 14, ES_AUTOHSCROLL | ES_CENTER | ES_READONLY | WS_TABSTOP
    RTEXT "Pin:", IDC_G_PIN_LABEL, 10, 85, 56, 14, SS_CENTERIMAGE
    EDITTEXT IDC_G_PIN_HOTKEY, 70, 85, 84, 14, ES_AUTOHSCROLL | ES_CENTER | ES_READONLY | WS_TABSTOP
    RTEXT "Delete:", IDC_G_DELETE_LABEL, 10, 103, 56, 14, SS_CENTERIMAGE
    EDITTEXT IDC_G_DELETE_HOTKEY, 70, 103, 84, 14, ES_AUTOHSCROLL | ES_CENTER | ES_READONLY | WS_TABSTOP
    RTEXT "Preview:", IDC_G_PREVIEW_LABEL, 10, 121, 56, 14, SS_CENTERIMAGE
    EDITTEXT IDC_G_PREVIEW_HOTKEY, 70, 121, 84, 14, ES_AUTOHSCROLL | ES_CENTER | ES_READONLY | WS_TABSTOP

    CONTROL "", IDC_STATIC, "Static", SS_OWNERDRAW, 10, 143, 316, 1
    RTEXT "Search:", IDC_G_SEARCH_LABEL, 10, 151, 56, 12, SS_CENTERIMAGE
    COMBOBOX IDC_G_SEARCH_MODE, 70, 151, 84, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL "", IDC_STATIC, "Static", SS_OWNERDRAW, 10, 172, 316, 1
    RTEXT "Behavior:", IDC_G_BEHAVIOR_LABEL, 10, 180, 56, 10, SS_CENTERIMAGE
    CONTROL "Paste automatically", IDC_G_PASTE_BY_DEFAULT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 180, 256, 10
    CONTROL "Paste as plain text", IDC_G_REMOVE_FORMATTING, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 193, 256, 10
    LTEXT "Customize what happens when selecting an item:\r\n• Hold Enter to select an item to copy.\r\n• Hold Alt+Enter to select an item to copy and paste.\r\n• Hold Alt+Shift+Enter to select an item to copy and paste with matching formatting.", IDC_G_BEHAVIOR_HINT, 70, 208, 256, 40, SS_NOPREFIX

    CONTROL "", IDC_STATIC, "Static", SS_OWNERDRAW, 10, 256, 316, 1
    PUSHBUTTON "Notifications and sounds", IDC_G_NOTIFICATIONS, 70, 264, 84, 14
END

IDD_PAGE_APPEARANCE DIALOGEX 2, 13, 336, 304
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    // Keep 14 DLU for the expanded list; the closed field follows the font.
    RTEXT "Popup position:", IDC_A_POPUP_POSITION_LABEL, 10, 10, 56, 12, SS_CENTERIMAGE
    COMBOBOX IDC_A_POPUP_POSITION, 70, 10, 84, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT "Screen:", IDC_A_SCREEN_LABEL, 160, 10, 36, 12, SS_CENTERIMAGE
    COMBOBOX IDC_A_POPUP_SCREEN, 200, 10, 70, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Reset position", IDC_A_RESET_POSITION, 276, 10, 50, 14
    RTEXT "Pin to:", IDC_A_PIN_TO_LABEL, 10, 27, 56, 12, SS_CENTERIMAGE
    COMBOBOX IDC_A_PIN_TO, 70, 27, 84, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT "Highlight matches:", IDC_A_HIGHLIGHT_LABEL, 10, 44, 56, 12, SS_CENTERIMAGE
    COMBOBOX IDC_A_HIGHLIGHT, 70, 44, 84, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL "", IDC_STATIC, "Static", SS_OWNERDRAW, 10, 64, 316, 1
    RTEXT "Image height:", IDC_A_IMAGE_HEIGHT_LABEL, 10, 72, 56, 14, SS_CENTERIMAGE
    EDITTEXT IDC_A_IMAGE_HEIGHT, 70, 72, 50, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    RTEXT "Preview delay:", IDC_A_PREVIEW_DELAY_LABEL, 10, 90, 56, 14, SS_CENTERIMAGE
    EDITTEXT IDC_A_PREVIEW_DELAY, 70, 90, 50, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    CONTROL "Open preview automatically", IDC_A_OPEN_PREVIEW, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 108, 256, 10

    CONTROL "", IDC_STATIC, "Static", SS_OWNERDRAW, 10, 126, 316, 1
    CONTROL "Show special symbols", IDC_A_SHOW_SPECIAL, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 134, 256, 10
    CONTROL "Show system tray icon", IDC_A_SHOW_STATUS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 147, 256, 10
    COMBOBOX IDC_A_MENU_ICON, 82, 160, 84, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Show recent clipboard content next to the system tray icon", IDC_A_SHOW_RECENT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_DISABLED, 70, 177, 256, 10
    CONTROL "Show search box", IDC_A_SHOW_SEARCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 190, 256, 10
    COMBOBOX IDC_A_SEARCH_VISIBILITY, 82, 203, 84, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Show the application name before the search box", IDC_A_SHOW_TITLE, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 220, 256, 10
    CONTROL "Show application icons", IDC_A_SHOW_ICONS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 233, 256, 10
    CONTROL "Show hexadecimal color swatches", IDC_A_SHOW_SWATCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 246, 256, 10
    CONTROL "Show footer menu", IDC_A_SHOW_FOOTER, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 259, 256, 10
END

IDD_PAGE_THEMES DIALOGEX 2, 13, 336, 304
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    // Wide enough for "Match Windows".
    RTEXT "Mode:", IDC_T_MODE_LABEL, 10, 10, 56, 12, SS_CENTERIMAGE
    COMBOBOX IDC_T_MODE, 70, 10, 96, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Every theme has a light and a dark version; Mode picks which one you see.", IDC_T_MODE_HINT, 70, 28, 256, 10, SS_CENTERIMAGE | SS_NOPREFIX

    CONTROL "", IDC_STATIC, "Static", SS_OWNERDRAW, 10, 46, 316, 1
    // ThemeGallery subclasses this static and paints every pixel of it.
    // SS_NOTIFY makes it hit-testable, so the mouse reaches it.
    CONTROL "", IDC_T_GALLERY, "Static", SS_NOTIFY | WS_TABSTOP, 10, 54, 316, 240
END

IDD_PAGE_STORAGE DIALOGEX 2, 13, 336, 304
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    RTEXT "Save:", IDC_S_SAVE_LABEL, 10, 10, 56, 10, SS_CENTERIMAGE
    CONTROL "Files", IDC_S_SAVE_FILES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 10, 256, 10
    CONTROL "Images", IDC_S_SAVE_IMAGES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 23, 256, 10
    CONTROL "Text", IDC_S_SAVE_TEXT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 70, 36, 256, 10
    LTEXT "Choose which types of content are saved.", IDC_S_DESCRIPTION, 70, 50, 256, 10, SS_CENTERIMAGE | SS_NOPREFIX

    CONTROL "", IDC_STATIC, "Static", SS_OWNERDRAW, 10, 68, 316, 1
    RTEXT "Count:", IDC_S_COUNT_LABEL, 10, 76, 56, 14, SS_CENTERIMAGE
    EDITTEXT IDC_S_HISTORY_SIZE, 70, 76, 50, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_S_STORAGE_SIZE, 126, 76, 200, 14, SS_CENTERIMAGE | SS_NOPREFIX
    RTEXT "Sort by:", IDC_S_SORT_LABEL, 10, 94, 56, 12, SS_CENTERIMAGE
    COMBOBOX IDC_S_SORT_BY, 70, 94, 96, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_PAGE_IGNORE DIALOGEX 2, 13, 336, 304
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    // The ignore sub-pages are created as siblings above this tab control.
    CONTROL "", IDC_IGNORE_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_CLIPSIBLINGS | TCS_TABS, 10, 8, 316, 288
END

// The ignore sub-pages fill the inner tab control's display area (about
// 312 x 270 DLU); their controls keep these positions.
IDD_IGNORE_APPLICATIONS DIALOGEX 2, 13, 312, 268
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_I_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | LVS_EDITLABELS | WS_TABSTOP | WS_BORDER, 8, 8, 296, 178, WS_EX_CLIENTEDGE
    PUSHBUTTON "Add", IDC_I_ADD, 8, 192, 50, 14
    PUSHBUTTON "Remove", IDC_I_REMOVE, 62, 192, 50, 14
    CONTROL "Ignore all applications except those in the list", IDC_I_WHITELIST, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 214, 296, 10
    LTEXT "", IDC_I_DESCRIPTION, 8, 230, 296, 32, SS_NOPREFIX
END

IDD_IGNORE_FORMATS DIALOGEX 2, 13, 312, 268
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_I_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_TABSTOP | WS_BORDER, 8, 8, 296, 178, WS_EX_CLIENTEDGE
    PUSHBUTTON "Add", IDC_I_ADD, 8, 192, 50, 14
    PUSHBUTTON "Remove", IDC_I_REMOVE, 62, 192, 50, 14
    PUSHBUTTON "Reset", IDC_I_RESET, 254, 192, 50, 14
    LTEXT "", IDC_I_DESCRIPTION, 8, 214, 296, 48, SS_NOPREFIX
END

IDD_IGNORE_REGEXPS DIALOGEX 2, 13, 312, 268
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_I_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_TABSTOP | WS_BORDER, 8, 8, 296, 178, WS_EX_CLIENTEDGE
    PUSHBUTTON "Add", IDC_I_ADD, 8, 192, 50, 14
    PUSHBUTTON "Remove", IDC_I_REMOVE, 62, 192, 50, 14
