IDD_PAGE_PINS DIALOGEX 2, 13, 336, 304
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_P_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_TABSTOP | WS_BORDER, 10, 10, 316, 250, WS_EX_CLIENTEDGE
    LTEXT "You can customize the hotkey, title, and content of any pinned item.\r\nTo edit an item, double-click it and enter a new value.", IDC_P_LIST_HINT, 10, 268, 316, 24, SS_NOPREFIX
END

IDD_PAGE_ADVANCED DIALOGEX 2, 13, 336, 304
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    // Descriptions sit under their check box's text, not under its box.
    CONTROL "Pause", IDC_X_IGNORE_EVENTS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 10, 10, 316, 10
    LTEXT "Pause recording new clipboard items.\r\nUse this when you want to disable recording programmatically while copying sensitive data.", IDC_X_DESCRIPTION, 22, 23, 304, 18, SS_LEFT | SS_NOPREFIX
    CONTROL "Ignore only the next clipboard change", IDC_X_IGNORE_NEXT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 10, 46, 316, 10

    CONTROL "", IDC_STATIC, "Static", SS_OWNERDRAW, 10, 64, 316, 1
    CONTROL "Clear history on exit", IDC_X_CLEAR_ON_QUIT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 10, 72, 316, 10
    CONTROL "Clear the system clipboard too", IDC_X_CLEAR_CLIPBOARD, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 10, 85, 316, 10

    CONTROL "", IDC_STATIC, "Static", SS_OWNERDRAW, 10, 103, 316, 1
    CONTROL "Respect Windows clipboard history markers", IDC_X_RESPECT_WINDOWS_CLIPBOARD_HISTORY, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 10, 111, 316, 10
    LTEXT "Do not record content marked by Windows as excluded from clipboard history.", IDC_X_HISTORY_DESCRIPTION, 22, 124, 304, 10, SS_LEFT | SS_NOPREFIX
END

IDD_EDIT_PIN DIALOGEX 0, 0, 280, 200
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit pinned item"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Hotkey (&K):", IDC_EDIT_PIN_KEY_LABEL, 10, 11, 50, 12, SS_CENTERIMAGE
    COMBOBOX IDC_EDIT_PIN_KEY, 64, 11, 60, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Alias (&T):", IDC_EDIT_PIN_TITLE_LABEL, 10, 32, 260, 10, SS_CENTERIMAGE
    EDITTEXT IDC_EDIT_PIN_TITLE, 10, 44, 260, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "Content (&C):", IDC_EDIT_PIN_CONTENT_LABEL, 10, 66, 260, 10, SS_CENTERIMAGE
    EDITTEXT IDC_EDIT_PIN_CONTENT, 10, 78, 260, 72, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_P_CONTENT_HINT, 10, 154, 260, 18, SS_CENTERIMAGE | SS_NOPREFIX
    DEFPUSHBUTTON "OK", IDOK, 156, 178, 56, 14
    PUSHBUTTON "Cancel", IDCANCEL, 214, 178, 56, 14
END

IDD_EDIT_IGNORE DIALOGEX 0, 0, 280, 120
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit ignore item"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Value (&V):", IDC_EDIT_IGNORE_VALUE_LABEL, 10, 10, 260, 10, SS_CENTERIMAGE
    EDITTEXT IDC_EDIT_IGNORE_VALUE, 10, 22, 260, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_I_DESCRIPTION, 10, 42, 260, 46, SS_NOPREFIX
    DEFPUSHBUTTON "OK", IDOK, 156, 98, 56, 14
    PUSHBUTTON "Cancel", IDCANCEL, 214, 98, 56, 14
END
